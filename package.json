{
  "name": "turbowarp-obs-websocket",
  "version": "1.0.0",
  "description": "OBS WebSocket extension for TurboWarp",
  "main": "dist/turbowarp_studio.js",
  "scripts": {
    "build": "node esbuild.js",
    "dev": "node esbuild.js --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier . --write",
    "check-format": "prettier . --check"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@turbowarp/types": "github:TurboWarp/types-tw#tw",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.19.0",
    "eslint": "^10.3.0",
    "esquery": "^1.7.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
